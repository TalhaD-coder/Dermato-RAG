# ============================================
# Dermato-RAG Ortam Değişkenleri Şablonu
# ============================================
# Bu dosyayı ".env" olarak kopyalayın ve
# kendi API anahtarlarınızı girin.
# ============================================

# ---- OpenAI API ----
OPENAI_API_KEY=your_openai_api_key_here

# ---- Google Gemini API ----
GOOGLE_API_KEY=your_google_api_key_here

# ---- NCBI / PubMed API ----
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=your_ncbi_api_key_here

# ---- Weights & Biases ----
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=dermato-rag

# ---- Hugging Face (opsiyonel) ----
HF_TOKEN=your_huggingface_token_here

# ---- Konfigürasyon Override ----
# Format: DERMATO_RAG__{SECTION}__{KEY}=value
# Örnek:
# DERMATO_RAG__LOGGING__LEVEL=DEBUG
# DERMATO_RAG__DEVICE__USE_GPU=false
