# ============================================
# Dermato-RAG .gitignore
# ============================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl

# ---- Virtual Environment ----
venv/
.venv/
env/
ENV/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- Data (büyük dosyalar git'e eklenmez) ----
data/raw/
data/processed/
data/embeddings/
data/knowledge_base/raw_docs/
*.h5
*.hdf5
*.parquet
*.feather

# ---- Model Weights ----
/models/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# ---- Logs ----
logs/
*.log
wandb/

# ---- Environment Variables & Secrets ----
.env
.env.local
.env.production
*.key
*.pem

# ---- OS Files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Temporary Files ----
tmp/
temp/
*.tmp
*.bak
*.cache

# ---- Coverage & Test ----
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ---- Geçici çalışma dosyaları (debug / smoke test) ----
uvicorn_*.txt
uvicorn_*.log
result_*.json
_dict_check.js
sample_picks.json
rt.json
_r.json

# ---- Distribution ----
*.tar.gz
*.zip
